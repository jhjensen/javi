# Dockerfile.guitest — Headless GUI testing for Javi editor
#
# Runs AssertJ Swing GUI tests inside Xvfb (virtual framebuffer).
# Requires no display on the host — fully self-contained.
#
# Build:  docker build -f Dockerfile.guitest -t javi-guitest .
# Run:    docker run --rm -v $(pwd)/build:/app/build javi-guitest
#
# The entrypoint starts Xvfb, runs `./gradlew guiTest`, and exits
# with the Gradle exit code.

FROM eclipse-temurin:24-jdk-noble

# Xvfb + X11 libraries for headless AWT rendering
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    libx11-6 \
    libxext6 \
    libxrender1 \
    libxtst6 \
    libxi6 \
    libxrandr2 \
    libfreetype6 \
    fontconfig \
    fonts-dejavu-core \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Gradle wrapper first for layer caching
COPY gradlew build.gradle ./
COPY gradle/ gradle/
RUN chmod +x gradlew && ./gradlew --no-daemon dependencies || true

# Copy source and test files
COPY src/ src/

# build.gradle calls `git describe --always --dirty` during evaluation;
# .git is excluded from rsync, so create a minimal repo
RUN git init && git config user.email "docker@build" && git config user.name "docker" && \
    git add -A && git commit -q -m "docker build"

# Start Xvfb, run GUI tests, stop Xvfb, exit with test status
ENTRYPOINT ["sh", "-c", \
    "Xvfb :99 -screen 0 1280x1024x24 -nolisten tcp & \
     sleep 1 && \
     DISPLAY=:99 ./gradlew --no-daemon guiTest; \
     status=$?; kill %1 2>/dev/null; exit $status"]
