# Dockerfile.alltest — Run ALL tests (headless + GUI) in Docker with Xvfb
#
# Runs both standard JUnit tests and AssertJ Swing GUI tests inside
# Xvfb. This covers the javi.awt package tests that need AWT classes
# initialized with a real display.
#
# Build:  docker build -f Dockerfile.alltest -t javi-alltest .
# Run:    docker run --rm -v $(pwd)/build:/app/build javi-alltest
#
# The entrypoint starts Xvfb, runs `./gradlew test guiTest`, and
# exits with the Gradle exit code.

FROM eclipse-temurin:24-jdk-noble

# Xvfb + X11 libraries for headless AWT rendering + clang-format for FormatDispatch tests
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    libx11-6 \
    libxext6 \
    libxrender1 \
    libxtst6 \
    libxi6 \
    libxrandr2 \
    libfreetype6 \
    fontconfig \
    fonts-dejavu-core \
    git \
    clang-format \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/clang-format /usr/local/bin/clang-format-mp-20

WORKDIR /app

# Copy Gradle wrapper first for layer caching
COPY gradlew build.gradle ./
COPY gradle/ gradle/
# Set Gradle home inside /app so deps are cached in image and
# accessible when running as non-root user with --user flag
ENV GRADLE_USER_HOME=/app/.gradle
RUN chmod +x gradlew && ./gradlew --no-daemon dependencies || true

# Cache-bust: ARG changes when source files are newer than Dockerfile
ARG SRC_HASH=0

# Copy source, test files, and clang-format config
COPY src/ src/
COPY .clang-format ./

# build.gradle calls `git describe --always --dirty` during evaluation;
# .git is excluded from rsync, so create a minimal repo
RUN git init && git config user.email "docker@build" && git config user.name "docker" && \
    git add -A && git commit -q -m "docker build" && \
    git config --system --add safe.directory /app

# Make directories writable for --user (non-root) execution
# Remove daemon dir so it gets created (and owned by) the runtime user,
# allowing Gradle to chmod it. Wrapper/deps cache remains intact.
RUN rm -rf /app/.gradle/daemon && \
    mkdir -p /app/build && chmod -R 777 /app /app/.gradle
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

# Start Xvfb, run ALL tests + legacy coverage + merged report, stop Xvfb.
# Gradle hangs after GUI tests due to AWT threads — detect output silence and kill.
ENTRYPOINT ["sh", "-c", "\
    Xvfb :99 -screen 0 1280x1024x24 -nolisten tcp & \
    sleep 1; \
    DISPLAY=:99 ./gradlew --no-daemon --continue test guiTest pstestCoverage intArrayTestCoverage mergedCoverageReport > /app/build/alltest-output.txt 2>&1 & \
    GPID=$!; \
    ELAPSED=0; QUIET=0; LASTSIZE=0; \
    while [ $ELAPSED -lt 900 ]; do \
        if ! kill -0 $GPID 2>/dev/null; then break; fi; \
        CURSIZE=$(wc -c < /app/build/alltest-output.txt 2>/dev/null || echo 0); \
        if [ \"$CURSIZE\" = \"$LASTSIZE\" ]; then \
            QUIET=$((QUIET + 3)); \
            if [ $QUIET -ge 30 ] && [ $CURSIZE -gt 1000 ]; then \
                kill $GPID 2>/dev/null; sleep 2; kill -9 $GPID 2>/dev/null; break; \
            fi; \
        else QUIET=0; LASTSIZE=$CURSIZE; fi; \
        sleep 3; ELAPSED=$((ELAPSED + 3)); \
    done; \
    kill -0 $GPID 2>/dev/null && kill -9 $GPID 2>/dev/null; \
    wait $GPID 2>/dev/null; status=$?; \
    if [ $status -eq 137 ] || [ $status -eq 143 ]; then \
        if grep -c ' PASSED$' /app/build/alltest-output.txt | grep -qv '^0$'; then status=0; fi; \
    fi; \
    kill %1 2>/dev/null; exit $status"]
